# .gitignore
# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environments ───────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
.python-version

# ── Environment / Secrets ──────────────────────────────────────────────────────
local.env
.env.local
.env.production
*.pem
*.key

# ── Testing & Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/

# ── Alembic ───────────────────────────────────────────────────────────────────
# Migrations ARE committed. A template that cannot build its own schema is not
# a template. Only the local scratch DB is ignored.
*.sqlite3

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Claude ────────────────────────────────────────────────────────────────────
.claude/

# ── Working notes ─────────────────────────────────────────────────────────────
# Planning and review docs. Kept on disk, out of the repo — they are scratch
# for whoever is working, not part of the template someone clones.
.note/
