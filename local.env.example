# local.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Fastango — environment template.
# `make setup` copies this to local.env. Never commit local.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Fastango
# One of: local | test | testing | staging | production
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0
# REQUIRED — no default. Rejected outside development if it is still this
# placeholder or shorter than 32 characters. Generate: openssl rand -hex 32
SECRET_KEY=super-secret-dev-key-change-in-production-to-long-random-string
# Tighten to your real hostnames in production. "testserver" is added
# automatically in test environments only.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Modules ───────────────────────────────────────────────────────────────────
# JSON lists. ENABLED_MODULES empty = mount all; DISABLED_MODULES always wins.
# Disabled modules keep their DB models registered for Alembic migrations.
# ENABLED_MODULES=["auth"]
# DISABLED_MODULES=[]

# ── Database (REQUIRED — no default) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastango_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# ── Authentication ────────────────────────────────────────────────────────────
# Close self-service signup without a code change. Login is unaffected.
REGISTRATION_ENABLED=true
# bcrypt cost factor. Explicit because the library default drifts between
# releases, and a silently-changing security parameter is not one.
BCRYPT_ROUNDS=12

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# ── Redis ─────────────────────────────────────────────────────────────────────
# Backs the rate limiter. Empty falls back to in-memory storage, which is
# per-worker — fine for one process, wrong for any real deployment.
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# "*" is rejected at startup: credentials are enabled, so list exact origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
